{
  "designSystem": {
    "name": "Sonic Curator",
    "description": "Premium dark music curation interface with editorial sophistication", 
    "colors": {
      "primary": {
        "main": "#bbc3ff",
        "container": "#3d5afe",
        "on-container": "#f1f0ff"
      },
      "tertiary": {
        "main": "#3ce36a",
        "container": "#007f32",
        "on-container": "#c7ffc7"
      },
      "surface": {
        "background": "#131314",
        "surface": "#131314",
        "container": "#201f20",
        "container-low": "#1c1b1c",
        "container-high": "#2a2a2b",
        "container-highest": "#353436",
        "bright": "#39393a"
      },
      "text": {
        "on-surface": "#e5e2e3",
        "on-surface-variant": "#c5c5d9",
        "on-primary": "#001d93",
        "on-tertiary": "#003912"
      },
      "outline": {
        "main": "#8e8fa2",
        "variant": "#444656"
      }
    },
    "typography": {
      "fontFamily": {
        "primary": "Manrope",
        "fallback": "sans-serif"
      },
      "scales": {
        "display": {
          "fontSize": "2.5rem",
          "lineHeight": "1.2",
          "fontWeight": "600",
          "letterSpacing": "-0.02em"
        },
        "headline": {
          "fontSize": "1.875rem",
          "lineHeight": "1.3", 
          "fontWeight": "600"
        },
        "title": {
          "fontSize": "1.25rem",
          "lineHeight": "1.4",
          "fontWeight": "500"
        },
        "body": {
          "fontSize": "1rem",
          "lineHeight": "1.5",
          "fontWeight": "400"
        },
        "label": {
          "fontSize": "0.875rem",
          "lineHeight": "1.4",
          "fontWeight": "500"
        }
      }
    },
    "spacing": {
      "xs": "0.25rem",
      "sm": "0.5rem", 
      "md": "1rem",
      "lg": "1.5rem",
      "xl": "2rem",
      "2xl": "3rem",
      "3xl": "4rem"
    },
    "borderRadius": {
      "sm": "0.25rem",
      "md": "0.75rem",
      "lg": "1rem",
      "xl": "1.25rem",
      "full": "9999px"
    },
    "effects": {
      "glassPlayer": "linear-gradient(135deg, rgba(187, 195, 255, 0.1) 0%, rgba(32, 31, 32, 0.8) 100%)",
      "textGlow": "0 0 12px rgba(187, 195, 255, 0.4)",
      "backdropBlur": "24px",
      "cardHover": "transition-all duration-200 ease-out"
    },
    "layout": {
      "sidebarWidth": "16rem",
      "maxContentWidth": "1200px",
      "gridGap": "1.5rem"
    }
  }
}